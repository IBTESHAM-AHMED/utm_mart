rules_version = '2';

// Images are currently uploaded to a third-party host (see
// ImageUploadService); Firebase Storage is only touched by the legacy
// FirebaseService.uploadProductImage. Keep access narrow and drop the old
// catch-all that let any signed-in user read/write every object.
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underFiveMb() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Product images: signed-in users can read; uploads must be small images.
    match /products/{productId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isImage() && underFiveMb();
      allow update, delete: if false;
    }

    // Auction images: same constraints.
    match /auctions/{auctionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isImage() && underFiveMb();
      allow update, delete: if false;
    }

    // Profile images: readable by signed-in users, writable only by the owner.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isImage()
        && underFiveMb();
    }

    // Everything else is denied by default.
  }
}
