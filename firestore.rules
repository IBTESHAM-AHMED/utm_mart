rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users can read any user's profile (sellers need buyer contact info),
    // but can only create/modify their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Store collection - marketplace items.
    match /store/{itemId} {
      allow read: if true;

      // Items can only be created in your own name.
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid;

      allow update: if signedIn() && (
        // The seller can edit their own item freely.
        resource.data.sellerUid == request.auth.uid
        // Anyone else (a buyer at checkout / order receipt) may only LOWER
        // the stock count, and nothing else on the document.
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['itemStock', 'updatedAt'])
          && request.resource.data.itemStock is number
          && request.resource.data.itemStock >= 0
          && request.resource.data.itemStock <= resource.data.itemStock
        )
      );

      allow delete: if signedIn()
        && request.auth.uid == resource.data.sellerUid;
    }

    // Products collection (legacy). Owned by vendorId.
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.vendorId == request.auth.uid;
    }

    // Orders.
    // Parties to an order: the customer, the seller (top-level sellerUid),
    // and every seller listed in sellerUids (carts can contain several sellers).
    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || request.auth.uid in resource.data.sellerUids
      );

      // A customer places their own order. Auction orders are created for the
      // winning bidder by whichever client ends the auction, so they are
      // allowed with the auction marker; both must start as 'pending'.
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.customerId == request.auth.uid
          || (
            request.resource.data.isAuctionOrder == true
            && request.resource.data.sellerUid is string
          )
        );

      // Only the parties to the order may change its progress, and only the
      // status fields - never the customer, seller, items or amounts.
      allow update: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.sellerUid == request.auth.uid
          || request.auth.uid in resource.data.sellerUids
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paymentStatus', 'updatedAt']);

      allow delete: if signedIn()
        && request.auth.uid == resource.data.customerId;
    }

    // Categories (legacy). Owned by vendorId.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.vendorId == request.auth.uid;
    }

    // Addresses - private to their owner.
    match /addresses/{addressId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userUid;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userUid;
      allow update: if signedIn() && request.auth.uid == resource.data.userUid;
      allow delete: if signedIn() && request.auth.uid == resource.data.userUid;
    }

    // Auctions.
    match /auctions/{auctionId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid;

      allow update: if signedIn() && (
        // The seller manages their own auction.
        resource.data.sellerUid == request.auth.uid

        // Anyone can place a higher bid while the auction is open. Only the
        // bid fields (and an optional move to 'ended') may change.
        || (
          resource.data.status == 'active'
          && request.time < resource.data.endTime
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentBid', 'bids', 'updatedAt', 'status'])
          && request.resource.data.currentBid > resource.data.currentBid
          && (
            request.resource.data.status == resource.data.status
            || request.resource.data.status == 'ended'
          )
        )

        // Anyone viewing an auction past its end time can close it.
        || (
          request.time >= resource.data.endTime
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'ended'
        )
      );

      allow delete: if signedIn()
        && request.auth.uid == resource.data.sellerUid;
    }

    // Notifications. Created by whichever client triggers the event (e.g. an
    // outbid notice goes to ANOTHER user), but only the owner can read/change.
    match /notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid == resource.data.userId;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
